# Placeholder shown here uses the chari_sk_test_ prefix, which is recognised
# and auto-resolves to the sandbox base URL. If your real key doesn't start
# with chari_sk_test_ or chari_sk_live_ (e.g. a flex_... sandbox key), the
# SDK cannot infer the environment and construction throws — pass baseUrl
# explicitly instead, e.g. baseUrl: 'https://chari-pay-api.mobileappexpert.dev'.
CHARI_PAY_API_KEY=chari_sk_test_EXAMPLE
CHARI_PAY_WEBHOOK_SECRET=whsec_EXAMPLE
