{
  "name": "@chari-pay/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Chari Pay PSP — payments, links, checkout, subscriptions, refunds and verified webhooks.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": { "type": "git", "url": "git+https://github.com/chari-pay/chari-pay-sdk.git" },
  "homepage": "https://github.com/chari-pay/chari-pay-sdk#readme",
  "bugs": { "url": "https://github.com/chari-pay/chari-pay-sdk/issues" },
  "engines": { "node": ">=18" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./webhooks": { "types": "./dist/webhooks.d.ts", "import": "./dist/webhooks.js", "require": "./dist/webhooks.cjs" },
    "./express": { "types": "./dist/express.d.ts", "import": "./dist/express.js", "require": "./dist/express.cjs" },
    "./nestjs": { "types": "./dist/nestjs.d.ts", "import": "./dist/nestjs.js", "require": "./dist/nestjs.cjs" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "codegen": "openapi-typescript api-1.yaml -o src/generated/api.ts",
    "codegen:check": "openapi-typescript api-1.yaml -o /tmp/api.check.ts && diff -q /tmp/api.check.ts src/generated/api.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "npm run build && vitest run -c vitest.dist.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,adapters,test}/**/*.ts\"",
    "format": "prettier --write \"{src,adapters,test}/**/*.ts\""
  },
  "peerDependencies": { "express": ">=4", "@nestjs/common": ">=10" },
  "peerDependenciesMeta": {
    "express": { "optional": true },
    "@nestjs/common": { "optional": true }
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.1",
    "express": "^4.21.2",
    "openapi-typescript": "^7.5.0",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
